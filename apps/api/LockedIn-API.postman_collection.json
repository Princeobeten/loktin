              "raw": "{\n  \"contractId\": \"CCUBYPV6KJWOXPXGKKTG4DUKUW576S2CN7ABHW6BEDAYJWQ4IHRGJP2Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/analytics/refresh",
