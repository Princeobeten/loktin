            "description": "Refresh analytics by fetching latest data from the blockchain. Currently returns placeholder data - will be implemented to query the smart contract."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api",
